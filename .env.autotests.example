# URL локального приложения. Для безопасного smoke-прогона продакшена:
# QA_BASE_URL=https://startqa.ru
QA_BASE_URL=http://127.0.0.1:3000
QA_HEADLESS=true
QA_BROWSER=chromium
QA_TIMEOUT_MS=15000
QA_SCREENSHOT_DIR=autotests/artifacts

# Нужны только для сценариев авторизованного пользователя.
QA_STUDENT_LOGIN=
QA_STUDENT_PASSWORD=
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

# Cross-user RLS tests run only on a disposable staging project after the exact
# expected hosts and staging confirmation have been explicitly set.
QA_CROSS_USER_APP_URL=
QA_CROSS_USER_EXPECTED_APP_HOST=
QA_CROSS_USER_SUPABASE_URL=
QA_CROSS_USER_EXPECTED_SUPABASE_HOST=
QA_CROSS_USER_SUPABASE_ANON_KEY=
QA_SECOND_STUDENT_LOGIN=
QA_SECOND_STUDENT_PASSWORD=
QA_CROSS_USER_STAGING_CONFIRM=false

# Concurrent Archie limiter integration (staging-only, creates then deletes 3 rows).
QA_ARCHIE_RATE_LIMIT_SUPABASE_URL=
QA_ARCHIE_RATE_LIMIT_EXPECTED_HOST=
QA_ARCHIE_RATE_LIMIT_STAGING_PROJECT_REF=
QA_ARCHIE_RATE_LIMIT_SERVICE_ROLE_KEY=
QA_ARCHIE_RATE_LIMIT_TEST_USER_ID=
QA_ARCHIE_RATE_LIMIT_TEST_LESSON_ID=
QA_ARCHIE_RATE_LIMIT_STAGING_CONFIRM=false

# Изменяющие данные сценарии выключены по умолчанию.
# Включайте их только с отдельной одноразовой тестовой учёткой.
QA_ALLOW_MUTATION=false
QA_RUN_PROD_MUTATION=false
